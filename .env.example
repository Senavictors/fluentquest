DATABASE_URL=postgresql://fluentquest:CHANGE_ME@localhost:5432/fluentquest
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:3215
AI_ENABLED=false
AI_TEXT_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
YOUTUBE_API_KEY=
# Activation also requires a reviewed provider price registry (docs/INTEGRACOES.md).
AI_PRICES_REVIEWED_ON=
OPENAI_PRICES_REVIEWED_ON=
GEMINI_INPUT_USD_PER_MILLION=0.30
GEMINI_OUTPUT_USD_PER_MILLION=2.50
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_INPUT_USD_PER_MILLION=0.15
OPENAI_OUTPUT_USD_PER_MILLION=0.60
OPENAI_MODEL=gpt-4o-mini
# Dedicated model for public YouTube URLs. Review prices before enabling it.
GEMINI_VIDEO_MODEL=gemini-3.5-flash-lite
GEMINI_VIDEO_INPUT_USD_PER_MILLION=0.30
GEMINI_VIDEO_OUTPUT_USD_PER_MILLION=2.50
DATA_DIR=./data
PG_BIN=C:/Program Files/PostgreSQL/18/bin
